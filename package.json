{
  "name": "aether-hi-res-audio-player",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && node scripts/finalize-pwa.mjs && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "assets:android": "node scripts/generate-android-assets.mjs",
    "build:android": "npm run assets:android && vite build && node scripts/finalize-pwa.mjs && npx cap sync android",
    "android:sync": "npm run build:android",
    "android:apk": "npm run build:android && cd android && ./gradlew assembleDebug",
    "android:open": "npm run build:android && npx cap open android",
    "cap:sync": "npx cap sync",
    "start": "NODE_ENV=production node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "build:pages": "vite build --mode pages && node scripts/finalize-pwa.mjs --pages"
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/app": "8.1.1",
    "@capacitor/cli": "8.6.0",
    "@capacitor/core": "8.6.0",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.3",
    "@tailwindcss/vite": "4.3.3",
    "@vitejs/plugin-react": "5.2.0",
    "dotenv": "17.4.2",
    "express": "4.22.3",
    "express-rate-limit": "8.7.2",
    "idb": "8.0.3",
    "lucide-react": "0.546.0",
    "motion": "12.43.0",
    "music-metadata": "11.16.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "vite": "6.4.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "4.17.25",
    "@types/node": "22.20.1",
    "@types/react": "19.0.12",
    "@types/react-dom": "19.0.4",
    "autoprefixer": "10.5.4",
    "esbuild": "0.25.12",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.1",
    "typescript": "5.8.3"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
