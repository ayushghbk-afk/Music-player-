# Server only. Never prefix secrets with VITE_ or put them in the Android package.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1/
LLM_MODEL=gpt-4o-mini
PORT=3000
DATA_DIR=./data
# Exact cross-origin clients; same-origin web needs no entry.
CORS_ORIGINS=https://localhost,capacitor://localhost
# Enable ONLY behind exactly one trusted, header-sanitizing reverse proxy.
TRUST_PROXY=0

# Public cloud API origin only. Never put Worker/Turso/B2 secrets in VITE_ variables.
VITE_CLOUD_API_URL=https://storage-cloudflare-worker.mr-hackerdon808.workers.dev
