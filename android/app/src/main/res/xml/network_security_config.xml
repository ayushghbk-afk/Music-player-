<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext is denied everywhere except the loopback interface, which the
  LocalTrackServer uses to stream imported audio from the WebView to native
  storage without Base64. Chromium treats http://127.0.0.1 and http://localhost
  as potentially-trustworthy origins, and nothing outside the device can reach
  a 127.0.0.1-bound socket, so this does not weaken app transport security.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
